# Copy to .env.local (gitignored) and fill in.

# Base URL of yanai-server. Leave empty for same-origin: the Vite dev proxy and
# the production reverse proxy both route /api/* to the Go server.
PUBLIC_API_BASE_URL=

# Dev auth (no real auth yet): seeded demo tenant + the demo teacher's users.id.
# Both are fixed by yanai-server/seed/seed_demo_tenant.sql and survive a reseed.
PUBLIC_TENANT_ID=11111111-1111-4111-8111-111111111111
PUBLIC_ACTOR_ID=22222222-2222-4222-8222-222222222222
