# Copy to .env and fill in. Empty values count as unset.

# The local Postgres (docs/local-postgres-setup.md).
DATABASE_URL=postgres://mawta_app:mawta_app@localhost:55432/mawta?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:mawta@localhost:55432/mawta?sslmode=disable
SESSION_COOKIE_SECURE=false

# --- Where the models run ------------------------------------------------------
# "local" is your own model server, any OpenAI-compatible one: Ollama on this
# computer, or Ollama/vLLM on the school's DGX Spark or on a cloud GPU server for
# a school without one. Give Ollama a context of at least 8k tokens: its default
# of 4096 cuts the agents' answers off (Ollama app > Settings > Context length,
# or OLLAMA_CONTEXT_LENGTH=8192 for `ollama serve`).
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=         # a remote server behind a proxy that asks for one

# "openrouter": open models too large for your server.
# OPENROUTER_API_KEY=sk-or-...

# --- One model per agent ("provider:model") ---------------------------------------
# Every agent has its own model and its own reasoning setting; none shares
# another's. An agent without a model is unavailable (its routes answer
# agent_unavailable). Move one agent between providers by editing its line.
#
# REASONING_EFFORT is sent only when set: "none" stops a model that reasons before
# answering (gemma4, qwen3) from spending its token budget on hidden reasoning.

# ✦ Planning (experience, criteria, evidences, sessions)
PLANNING_AGENT_MODEL=local:gemma4:12b-it-qat
PLANNING_AGENT_REASONING_EFFORT=none

# Name sweep of voice notes: which names a note mentions, and whether it is the
# assigned student's. A short task: a small model is enough.
REDACTION_AGENT_MODEL=local:qwen3:4b
REDACTION_AGENT_REASONING_EFFORT=none

# Descriptive conclusions: the hardest text to write. A larger model helps.
CONCLUSIONS_AGENT_MODEL=openrouter:openai/gpt-oss-120b
# CONCLUSIONS_AGENT_REASONING_EFFORT=low

# A local model is slower: give one call (AGENT_TIMEOUT) and a whole generation,
# repair round included (AGENT_DEADLINE), the time it needs.
# AGENT_TIMEOUT=10m
# AGENT_DEADLINE=15m

# --- Voice-note transcription (Whisper through OpenRouter) ----------------------
# TRANSCRIBE_OPENROUTER_API_KEY=sk-or-...

# --- The director's chat token (uv run chatkey -kid k-local) ----------------------
# CHAT_TOKEN_SIGNING_KEY=
# CHAT_TOKEN_KEY_ID=k-local
