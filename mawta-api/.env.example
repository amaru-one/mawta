# Copy to .env and fill in. Empty values count as unset.

# The local Postgres (docs/local-postgres-setup.md).
DATABASE_URL=postgres://mawta_app:mawta_app@localhost:55432/mawta?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:mawta@localhost:55432/mawta?sslmode=disable
SESSION_COOKIE_SECURE=false

# --- Mawta's agents ("✦ Generar con Mawta") ------------------------------------
# Each agent runs on an open model named "provider:model". The provider is
# ollama (a local Ollama) or openrouter. Move an agent between them by editing
# its line and restarting. An agent without a model is simply unavailable.

# Local: Ollama on this computer. Pull a model first (ollama pull <model>) and
# give Ollama a context of at least 8k tokens: its default of 4096 cuts the
# agents' answers off (Ollama app > Settings > Context length, or
# OLLAMA_CONTEXT_LENGTH=8192 for `ollama serve`).
OLLAMA_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=            # only if your Ollama sits behind a proxy that asks for one

PLANNING_AGENT_MODEL=ollama:gemma4:12b-it-qat
CONCLUSIONS_AGENT_MODEL=ollama:gemma4:12b-it-qat
# Other models to try, by the size of the machine:
# PLANNING_AGENT_MODEL=ollama:qwen3:8b
# PLANNING_AGENT_MODEL=ollama:gpt-oss:20b

# OpenRouter: open models too large for this computer.
# OPENROUTER_API_KEY=sk-or-...
# PLANNING_AGENT_MODEL=openrouter:openai/gpt-oss-120b
# CONCLUSIONS_AGENT_MODEL=openrouter:qwen/qwen3-235b-a22b-2507

# Models that reason before answering (gemma4, qwen3) spend their token budget on
# hidden reasoning and get cut off; "none" turns that off. Leave empty to send nothing.
AGENT_REASONING_EFFORT=none

# A local model is slower: give one call (AGENT_TIMEOUT) and a whole generation,
# repair round included (AGENT_DEADLINE), the time it needs.
# AGENT_TIMEOUT=10m
# AGENT_DEADLINE=15m

# Optional prices (US dollars per million tokens) to record a cost per generation.
# AGENT_PRICE_INPUT_PER_MTOK=
# AGENT_PRICE_OUTPUT_PER_MTOK=
# CONCLUSIONS_AGENT_PRICE_INPUT_PER_MTOK=
# CONCLUSIONS_AGENT_PRICE_OUTPUT_PER_MTOK=

# --- Voice-note transcription (Whisper through OpenRouter) ----------------------
# TRANSCRIBE_OPENROUTER_API_KEY=sk-or-...

# --- The director's chat token (uv run chatkey -kid k-local) ----------------------
# CHAT_TOKEN_SIGNING_KEY=
# CHAT_TOKEN_KEY_ID=k-local
