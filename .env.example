# Copy to .env for local development and fill in. Empty values count as unset.
# In production these come from mawta-ops (compose/docker-compose.prod.yml and the droplet's .env).

# The app connects as mawta_app; migrations, onboard and useradd as the owner (a superuser).
DATABASE_URL=postgres://mawta_app:app-local@127.0.0.1:5432/mawta
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mawta
MAWTA_MIGRATIONS_URL=postgres://postgres:postgres@127.0.0.1:5432/mawta
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Models ("provider:model") -----------------------------------------------------------
# "local:<model>" is your own OpenAI-compatible server (Ollama, vLLM); "openrouter:<model>" is
# OpenRouter. An agent or the chat without a model is unavailable; the rest of the app works.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=
# OpenRouter: voice-note transcription (Whisper) always uses it, the agents and the chat when
# their model is "openrouter:...".
# OPENROUTER_API_KEY=sk-or-...

# PLANNING_AGENT_MODEL=local:gemma4:12b-it-qat
# PLANNING_AGENT_REASONING_EFFORT=none
# REDACTION_AGENT_MODEL=local:qwen3:4b
# REDACTION_AGENT_REASONING_EFFORT=none
# CONCLUSIONS_AGENT_MODEL=local:gemma4:12b-it-qat
# CONCLUSIONS_AGENT_REASONING_EFFORT=none
# AGENT_TIMEOUT=10m
# AGENT_DEADLINE=15m

# --- The director chat -------------------------------------------------------------------
# Its memory is this same database, schema langgraph, as mawta_langgraph.
# CHAT_MODEL=openrouter:qwen/qwen3-235b-a22b
# CHAT_REASONING_EFFORT=
# LANGGRAPH_DATABASE_URL=postgres://mawta_langgraph:lg-local@127.0.0.1:5432/mawta?options=-c%20search_path%3Dlanggraph
