# Copy to .env.local (gitignored) and fill in.

# Base URL of mawta-server. Leave empty for same-origin: the Vite dev proxy and
# the production reverse proxy both route /api/* to the Go server.
PUBLIC_API_BASE_URL=

# Auth is real: the API issues an HttpOnly session cookie on POST
# /auth/login. Nothing to set here for it — create an account with
# `go run ./cmd/useradd` in mawta-server, then log in from /login.

# Use the in-memory mock for the planning API instead of the real server.
# Set to 'mock' during UI development; any other value calls the real API.
PUBLIC_PLANNING_API=

# Enable the 'Plan del trimestre' entry in the class panel.
# Set to 'true' to show the row; any other value hides it.
PUBLIC_PLANNING_ENABLED=
