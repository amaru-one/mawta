# Example environment file for the droplet observability stack.
#
# Copy the variables below into /srv/mawta/.env (the same env file the
# production stack uses) — do NOT commit the real file. The stack is started
# with:
#
#   docker compose --env-file .env \
#     -f deploy/observability/docker-compose.droplet.yml up -d
#
# This example file is also used by the Compose validation check, so it must
# list every variable docker-compose.droplet.yml reads.

# Grafana admin password (REQUIRED).
# Generate with: openssl rand -base64 32
# It only takes effect when Grafana creates its database on first start;
# change it later with:
#   docker compose --env-file .env -f deploy/observability/docker-compose.droplet.yml \
#     exec grafana grafana cli admin reset-admin-password '<new>'
GRAFANA_ADMIN_PASSWORD=change-me-to-a-secure-password

# Environment label for logs (the Loki `environment` stream label).
MAWTA_ENVIRONMENT=prod

# Compose project to collect from (the production `mawta` project's `api`
# service). Locally this is `mawta-local`; on the droplet it is `mawta`.
MAWTA_COMPOSE_PROJECT=mawta

# Optional: change the Grafana port if 3000 is already in use on the
# droplet's loopback interface. Grafana is always bound to 127.0.0.1 only.
# GRAFANA_PORT=3000
