# The mawta database as the mawta_chat role (reads chat_api, writes chat).
CHAT_DATABASE_URL=postgres://mawta_chat:mawta_chat@localhost:55432/mawta?sslmode=disable
# LangGraph's own database (checkpoints).
LANGGRAPH_DATABASE_URL=postgres://postgres:mawta@localhost:55432/langgraph?sslmode=disable
# {"kid": "<base64 public key>"}: the keys mawta-api signs chat tokens with.
CHAT_TOKEN_PUBLIC_KEYS={"k-local":"<public key from uv run chatkey --kid k-local, in mawta-api>"}

# The chat's own model as "provider:model". "local" is your model server (Ollama on
# this computer, or Ollama/vLLM on a DGX Spark or a cloud server); "openrouter" is
# OpenRouter. Give Ollama a context of at least 8k tokens (its default 4096 is too small).
CHAT_MODEL=local:gemma4:12b-it-qat
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=         # a remote server behind a proxy that asks for one
# Or a larger open model through OpenRouter:
# CHAT_MODEL=openrouter:openai/gpt-oss-120b
# OPENROUTER_API_KEY=sk-or-...

# Models that reason before answering (gemma4, qwen3) spend their token budget
# on hidden reasoning; "none" turns that off. Leave empty to send nothing.
CHAT_REASONING_EFFORT=none

# Optional
# CHAT_MAX_TOKENS=16000
# CHAT_MAX_MODEL_CALLS=6
